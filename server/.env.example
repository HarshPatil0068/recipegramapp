# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/recipegram

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_NO_ORIGIN=true
CORS_CREDENTIALS=true
CORS_OPTIONS_SUCCESS_STATUS=200

# Socket.IO Configuration
SOCKET_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SOCKET_CORS_CREDENTIALS=true

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
RECIPE_AI_MAX_SUGGESTIONS=5
RECIPE_AI_TEMPERATURE=0.4

# Optional: File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp
